<?xml version="1.0" encoding="utf-8"?>
<!--
  rutter's Android manifest.

  There is no Java in this app and no classes.dex in the APK. That is the
  point of `android:hasCode="false"` below: `android.app.NativeActivity` is a
  framework class, so the system can launch a purely native app with no
  application bytecode at all. The `android-activity` crate reimplements the
  NDK's native_app_glue in Rust and `winit` drives it from there.

  This is also what ../../opencpn could not do. Qt's Android port needs a Java
  activity to call into, which is exactly the tree OpenCPN never published —
  58 native calls, 37 of them to methods that do not exist anywhere public.
  Avoiding Java entirely avoids that whole class of problem.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pjhockey7.rutter"
    android:versionCode="1"
    android:versionName="0.1.0">

    <!--
      minSdk 24 is chosen, not inherited: API 21 and 22 hide fseeko/ftello
      under _FILE_OFFSET_BITS=64 and 23 and below hide nl_langinfo, each of
      which cost a day in the opencpn attempt. 24 is also where Vulkan became
      dependable, which wgpu cares about.
    -->
    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <!--
      Needed to open a socket at all — any socket, including a UDP bind on
      the boat's own WiFi with no route to the internet. Without it the
      NMEA reader fails with EACCES on the phone while working perfectly on
      the laptop, which is the least helpful way for this to break.

      An install-time permission, not a runtime one: there is no dialogue
      and nothing to ask the user for. It is also the *only* permission
      this app declares. Reading the GPS chip directly would need
      ACCESS_FINE_LOCATION and the runtime prompt that goes with it; taking
      position over the network instead means a chart app that asks for
      nothing.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The phone's own GPS. A runtime permission, so declaring it here only
      buys the right to ask; src/gps.rs does the asking, and the app runs
      perfectly well without it — the chart, the tides and a network feed
      all work with location refused.

      Both, not just the fine one. From API 31 a request for
      ACCESS_FINE_LOCATION that does not also ask for the coarse one is
      *ignored*: no dialogue appears and nothing is granted, which is
      indistinguishable from a user who said no.

      Not `android:required` on a feature, either: a tablet with no GPS
      should still install and still be a chart.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!--
      Vulkan rather than GL ES. Not required=true: wgpu falls back to GL ES,
      and refusing to install on a device without Vulkan would be a worse
      failure than running slower on one.
    -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="false" />

    <application
        android:label="rutter"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:debuggable="true">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:label="rutter"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density|uiMode">

            <!--
              Which library to load, without the `lib` prefix or the `.so`.
              The cdylib in platform/android/Cargo.toml is named `rutter`, so
              this resolves to librutter.so.
            -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="rutter" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
